# Application
APP_NAME=Portafolio Backend
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.miapp.com
# GENERATE: php artisan key:generate --show
APP_KEY=your_app_key_here

# Localization
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portafolio_backend
DB_USERNAME=portafolio_user
DB_PASSWORD=your_secure_password_here

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.miapp.com

# Queues & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=backend_

# Redis (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (configure according to your provider)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.miapp.com
MAIL_PORT=587
MAIL_USERNAME=noreply@miapp.com
MAIL_PASSWORD=your_mail_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@miapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# SSO Server (Authentication) — CRITICAL FOR PRODUCTION
SSO_URL=https://sso.miapp.com/api
SSO_JWT_ISSUER=https://sso.miapp.com
SSO_CLIENT_ID=main-app
SSO_CLIENT_SECRET=your_client_secret_here
# JWKS_CACHE_TTL=3600

# Other Services (AWS S3 for images, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=portafolio-uploads

# Passport (generated locally)
# CLIENT_ID and CLIENT_SECRET from: php artisan passport:client --personal
# PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
# PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=
