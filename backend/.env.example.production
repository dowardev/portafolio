# Plantilla de configuración de producción para Backend Portafolio
# Copiar a .env y completar con valores reales

# ============================================
# APLICACIÓN
# ============================================
APP_NAME=Portafolio Backend
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.miapp.com

# GENERAR: php artisan key:generate --show
APP_KEY=tu_app_key_aqui

# ============================================
# LOCALIZACIÓN
# ============================================
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ============================================
# MANTENIMIENTO
# ============================================
APP_MAINTENANCE_DRIVER=file

# ============================================
# SEGURIDAD
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# LOGS
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ============================================
# BASE DE DATOS (MySQL recomendado para producción)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portafolio_backend
DB_USERNAME=portafolio_user
DB_PASSWORD=tu_password_seguro_aqui

# ============================================
# SESIÓN
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.miapp.com

# ============================================
# COLAS Y CACHÉ
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=backend_

# ============================================
# REDIS (opcional)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# CORREO (configurar según tu proveedor)
# ============================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.miapp.com
MAIL_PORT=587
MAIL_USERNAME=noreply@miapp.com
MAIL_PASSWORD=tu_mail_password_aqui
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@miapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SSO SERVER - CRÍTICO PARA PRODUCCIÓN
# ============================================
# URL del servidor SSO (producción)
# Esta variable es OBLIGATORIA para autenticación
SSO_URL=https://sso.miapp.com/api

# ============================================
# OTROS SERVICIOS (AWS S3 para imágenes, etc.)
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=portafolio-uploads

# ============================================
# PASSPORT (generado localmente)
# ============================================
# CLIENT_ID y CLIENT_SECRET de: php artisan passport:client --personal
# PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
# PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=
