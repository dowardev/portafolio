# Server SSH (used by `scripts/deploy.sh` to bypass GitLab CI when CI minutes run out)
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Absolute paths on the server
DEPLOY_PATH_BACKEND=
DEPLOY_PATH_FRONTEND=

# Path to the private key used to SSH into the server.
# Defaults to ~/.ssh/id_rsa if left empty.
# See DEPLOY.md section 10 for when to uncomment this.
# SSH_PRIVATE_KEY_PATH=
