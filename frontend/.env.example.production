# Plantilla de configuración de producción para Frontend Ionic/Vue
# Copiar a .env.production y completar con valores reales

# ============================================
# API DEL BACKEND PORTAFOLIO
# ============================================
# URL base del backend del portafolio (producción)
VITE_API_URL=https://api.miapp.com/api/

# ============================================
# API DEL SSO SERVER
# ============================================
# URL base del servidor SSO (producción)
VITE_SSO_URL=https://sso.miapp.com/api/

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================
# Nombre de la aplicación (usado en titles, meta tags, etc.)
VITE_APP_NAME="Mi Portafolio"

# (Opcional) URL de Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# (Opcional) URL del servicio de errores
# VITE_ERROR_TRACKING_URL=https://errors.miapp.com
