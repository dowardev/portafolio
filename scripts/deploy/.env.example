# .env.example — portafolio deploy
# Copia este archivo a .env (en scripts/deploy/) y rellena los valores reales
# ESTE ARCHIVO SE COMMITEA — NO PONGAS SECRETOS REALES AQUÍ
# El .env real está en .gitignore

# ============================================================
# SSH Connection (matching GitLab CI/CD variables)
# ============================================================
SSH_HOST=195.179.236.189
SSH_PORT=65002
SSH_USER=u902881280

# Opción A: Key content (GitLab CI style) - pega la key privada completa
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"

# Opción B: Path to local key file (alternativa)
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# Opcional: known_hosts content (GitLab CI style)
# SSH_KNOWN_HOSTS="195.179.236.189 ssh-rsa AAAAB3NzaC1yc2E..."

# ============================================================
# Remote Deploy Paths (portafolio)
# ============================================================
DEPLOY_PATH_BACKEND=/home/u902881280/public_html/back
DEPLOY_PATH_FRONTEND=/home/u902881280/public_html/